    {
      "type": "stat",
      "title": "Awaiting sds-node-configurator",
      "description": "Resources being deleted that carry no finalizer of this module any more and are waiting for sds-node-configurator to remove the logical volume. No orphan series covers them, for the same reason. Two things it counts that the title does not suggest: resources this module never owned — the absence of its finalizer cannot tell that from \"already unblocked\" — and deletions that are legitimately still running, because the agent erases the volume as spec.volumeCleanup says before lvremove. Time here is normal; D8SdsLocalVolumeLVMLogicalVolumeDeletionStuck fires only after two hours of it.",
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 16,
        "y": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "$ds_prometheus"
      },
      "targets": [
        {
          "expr": "sum by (kind) (sds_local_volume_awaiting_agent_count)",
          "legendFormat": "{{kind}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
