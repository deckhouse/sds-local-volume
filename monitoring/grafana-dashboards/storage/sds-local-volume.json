    {
      "type": "stat",
      "title": "Orphans nobody deleted",
      "description": "LVMLogicalVolumes whose PersistentVolume is gone and which nobody has asked to delete. This is what D8SdsLocalVolumeOrphanedLVMLogicalVolumes reads. A volume annotated storage.deckhouse.io/retain-acknowledged=true is counted as retained instead and is not in here.",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "$ds_prometheus"
      },
      "targets": [
        {
          "expr": "max(sds_local_volume_orphaned_lvm_logical_volume_count{state=\"active\"})",
          "legendFormat": "active",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      }
    },
    {
