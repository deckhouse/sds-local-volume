    {
      "type": "stat",
      "title": "Reclaims refused",
      "description": "Deletions the controller is not completing. Which of the six reasons applies is in the reason label of sds_local_volume_orphaned_lvm_logical_volume_allocated_bytes, broken down per volume in the \"Which volumes are leaking\" table below. snapshots_present, agent_finalizer_absent, persistent_volume_exists and successor_in_place are properties of the volume that the controller deliberately refuses to override; api_error and removal_failed are faults in the module, and the second also raises D8SdsLocalVolumeCSIFinalizerRemovalErrors.",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "$ds_prometheus"
      },
      "targets": [
        {
          "expr": "max(sds_local_volume_orphaned_lvm_logical_volume_count{state=\"blocked\"})",
          "legendFormat": "blocked",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
